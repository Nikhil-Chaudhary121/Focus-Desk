{
  "name": "focus-desk",
  "version": "1.0.0",
  "description": "Todo + habit tracker with an always-on-top widget",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.me.focusdesk",
    "productName": "Focus Desk",
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
